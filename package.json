{
  "name": "kader-zari",
  "private": true,
  "type": "module",
  "description": "AI anlatıcılı, SRD 5.1 zar mekanikli RPG/strateji oyunu",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "play": "tsx scripts/play.ts",
    "test:db": "vitest run packages/store",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "e2e": "npm run e2e -w apps/web",
    "bundle:functions": "node scripts/bundle-functions.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "zod": "^4.6.5"
  },
  "version": "1.0.0"
}
